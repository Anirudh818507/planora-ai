{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "noEmit": true,
    "target": "es2020",
    "lib": ["es2020"],
    "types": ["node"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "netlify/functions/**/*", "api/**/*"]
}
