# Planora AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# AI Provider Configuration
# ============================================================

# Google Gemini API Key (get one at https://aistudio.google.com)
# Used server-side only - never expose in frontend bundle
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# App Configuration
# ============================================================

# Node environment
NODE_ENV=development

# ============================================================
# DEMO MODE
# ============================================================
# If GEMINI_API_KEY is not set, the app runs in demo mode
# with pre-built template responses. Demo mode is clearly
# labeled in the UI and does NOT call any external APIs.
