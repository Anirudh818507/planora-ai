# Normalise all text files to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.svg   text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
